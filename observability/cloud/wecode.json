{
  "uid": "wecode-cloud-overview",
  "title": "WeCode — Cloud application health",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "wecode",
    "opentelemetry"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(wecode_http_requests_total, deployment_environment_name)",
          "refId": "Environment"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "version",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(wecode_http_requests_total{deployment_environment_name=~\"$environment\"}, service_version)",
          "refId": "Version"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "description": "OpenTelemetry data from Render development and production.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment_environment_name) (rate(wecode_http_requests_total{service_name=\"wecode-api\",deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval]))",
          "legendFormat": "{{deployment_environment_name}} {{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP 5xx rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "description": "OpenTelemetry data from Render development and production.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment_environment_name) (rate(wecode_http_requests_total{service_name=\"wecode-api\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",http_response_status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{deployment_environment_name}} {{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Response time p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "description": "OpenTelemetry data from Render development and production.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,deployment_environment_name) (rate(wecode_http_duration_seconds_bucket{service_name=\"wecode-api\",deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval])))",
          "legendFormat": "{{deployment_environment_name}} {{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Successful registrations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "description": "Business counters appear after the corresponding application action. No data does not prove zero events.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment_environment_name) (increase(wecode_registrations_total{service_name=\"wecode-api\",deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__range]))",
          "legendFormat": "{{deployment_environment_name}} {{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Progress writes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "description": "Business counters appear after the corresponding application action. No data does not prove zero events.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment_environment_name,outcome) (rate(wecode_progress_writes_total{service_name=\"wecode-api\",deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval]))",
          "legendFormat": "{{deployment_environment_name}} {{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Authentication attempts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "description": "Business counters appear after the corresponding application action. No data does not prove zero events.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment_environment_name,outcome) (rate(wecode_auth_attempts_total{service_name=\"wecode-api\",deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval]))",
          "legendFormat": "{{deployment_environment_name}} {{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Request logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"wecode-api\",deployment_environment_name=~\"$environment\"} | service_version=~\"$version\""
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ]
}
